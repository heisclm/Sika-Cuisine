{
  "expo": {
    "name": "Sika Cuisine",
    "slug": "sika-cuisine",
    "scheme": "sikacuisine",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101010",
          "image": "./assets/adaptive-icon.png",
          "dark": {
            "image": "./assets/adaptive-icon.png",
            "backgroundColor": "#101010"
          },
          "imageWidth": 200
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101010"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sikacuisine.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101010"
      },
      "package": "com.sikacuisine.app",
      "versionCode": 1
    },
    "extra": {
      "apiUrl": "https://sika-cuisine.vercel.app/api/v1",
      "eas": {
        "projectId": "06eb3b3a-1343-411d-b713-7f18273777d9"
      }
    },
    "owner": "heisclm"
  }
}
