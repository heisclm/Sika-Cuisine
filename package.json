{
  "name": "sika-cuisine",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@sika/web",
    "build": "npm run build --workspace=@sika/web",
    "start": "npm run start --workspace=@sika/web",
    "lint": "npm run lint --workspace=@sika/web",
    "test": "npx tsx --test packages/shared/tests/shared.test.ts packages/shared/tests/api-integration.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
