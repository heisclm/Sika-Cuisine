# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL connection strings (postgresql://... pooled runtime URL + direct migration URL)
DATABASE_URL=""
DIRECT_URL=""

# Authentication (REQUIRED in production / npm start: >= 32 random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
JWT_SECRET=""

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
# Optional override; leave blank to verify Paystack webhooks with PAYSTACK_SECRET_KEY (default)
PAYSTACK_WEBHOOK_SECRET=""

# Rate Limiting (optional Upstash Redis REST credentials; falls back to memory locally)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloud Media Storage (optional Supabase Storage; falls back to local public/images/uploads)
SUPABASE_URL=""
# Supabase Secret key (sb_secret_...) or legacy service_role JWT
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="menu-images"

# Notifications (optional; skipped gracefully in local dev when unset)
# Free Option 1: Gmail App Password (recommended instant setup; strip or keep spaces)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional custom SMTP relay (overrides Gmail service when SMTP_HOST is set)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Option 2: Resend API (takes priority when set)
RESEND_API_KEY=""
EMAIL_FROM="Sika Cuisine <orders@sikacuisine.com>"
ARKESEL_API_KEY=""
SMS_SENDER_ID="SikaCuisine"
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
EXPO_ACCESS_TOKEN=""

# Restaurant Metadata
NEXT_PUBLIC_RESTAURANT_NAME="Sika Cuisine"
NEXT_PUBLIC_RESTAURANT_PHONE="0533376760"
NEXT_PUBLIC_RESTAURANT_WHATSAPP="+233533376760"
NEXT_PUBLIC_RESTAURANT_ADDRESS="Commercial Street, Sunyani Central, Bono Region, Ghana"
