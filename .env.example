# ==============================================================================
# SIKA CUISINE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Never commit production credentials, secret keys, or passwords to git.
# Copy this file to .env.local for local development.

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Transaction pooler URL (e.g. Supabase port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL for Prisma migrations (e.g. Supabase port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate with `openssl rand -base64 32`
AUTH_SECRET="your-32-byte-base64-auth-secret-placeholder"
JWT_SECRET="your-jwt-secret-key-placeholder"

# ------------------------------------------------------------------------------
# PAYSTACK PAYMENT INTEGRATION (GHANA - GHS)
# ------------------------------------------------------------------------------
# Paystack API Keys (from https://dashboard.paystack.com/#/settings/developer)
# Test keys begin with "pk_test_" and "sk_test_"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Webhook secret configured in Paystack Dashboard (used to verify HMAC SHA512 signature)
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret_here"

# ------------------------------------------------------------------------------
# RESTAURANT METADATA (Sunyani, Bono Region, Ghana)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RESTAURANT_NAME="Sika Cuisine"
NEXT_PUBLIC_RESTAURANT_CITY="Sunyani"
NEXT_PUBLIC_RESTAURANT_REGION="Bono Region"
NEXT_PUBLIC_RESTAURANT_PHONE="+233 24 000 0000"
NEXT_PUBLIC_RESTAURANT_EMAIL="info@sikacuisine.com"
NEXT_PUBLIC_RESTAURANT_ADDRESS="Commercial Street, Sunyani Central, Bono Region, Ghana"
