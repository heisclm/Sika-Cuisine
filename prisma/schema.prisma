// ==============================================================================
// SIKA CUISINE — PRISMA DATABASE SCHEMA (PostgreSQL / Supabase)
// Location: Sunyani, Bono Region, Ghana
// Currency Standard: Strict integer pesewas (1 GHS = 100 pesewas)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum FulfilmentType {
  DELIVERY
  COLLECTION
}

enum FulfilmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_COLLECTION
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PAYSTACK
  CASH_ON_DELIVERY
  CASH_ON_COLLECTION
}

enum PaymentAttemptStatus {
  INITIALIZED
  SUCCESS
  FAILED
  ABANDONED
}

// ------------------------------------------------------------------------------
// USERS & AUTHENTICATION
// ------------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders          Order[]
  addresses       DeliveryAddress[]
  auditLogs       AuditLog[]
  statusChanges   OrderStatusHistory[]

  @@index([email])
  @@index([role])
}

// ------------------------------------------------------------------------------
// MENU ARCHITECTURE
// ------------------------------------------------------------------------------

model MenuCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]

  @@index([slug])
  @@index([isActive])
}

model MenuItem {
  id                     String   @id @default(cuid())
  categoryId             String
  name                   String
  slug                   String   @unique
  description            String
  /** Strictly stored in integer pesewas (e.g. 5000 = GH₵50.00) */
  basePricePesewas       Int
  imageUrl               String
  isAvailable            Boolean  @default(true)
  isFeatured             Boolean  @default(false)
  spiceLevel             Int      @default(0) // 0 to 3
  preparationTimeMinutes Int      @default(20)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  category     MenuCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroups MenuItemOptionGroup[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([isAvailable])
  @@index([isFeatured])
}

model MenuItemOptionGroup {
  id          String   @id @default(cuid())
  menuItemId  String
  name        String   // e.g. "Choose Protein", "Pepper Sauce Level"
  description String?
  minSelect   Int      @default(0)
  maxSelect   Int      @default(1)
  isRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  MenuItemOption[]

  @@index([menuItemId])
}

model MenuItemOption {
  id                String   @id @default(cuid())
  optionGroupId     String
  name              String   // e.g. "Grilled Tilapia", "Fried Fish", "Extra Shito"
  /** Additional price in integer pesewas (e.g. 500 = GH₵5.00) */
  priceDeltaPesewas Int      @default(0)
  isAvailable       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  group MenuItemOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId])
}

// ------------------------------------------------------------------------------
// DELIVERY ADDRESSES (Sunyani, Bono Region)
// ------------------------------------------------------------------------------

model DeliveryAddress {
  id             String   @id @default(cuid())
  customerId     String?
  recipientName  String
  recipientPhone String
  alternatePhone String?
  streetAddress  String
  areaLocality   String   // e.g. "Fiapre", "Berlin Top", "Sunyani Central"
  landmark       String?  // e.g. "Opposite UENR Gate", "Near Regional Hospital"
  city           String   @default("Sunyani")
  deliveryNotes  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([customerId])
  @@index([areaLocality])
}

// ------------------------------------------------------------------------------
// ORDERS & FINANCIAL RECORDS
// ------------------------------------------------------------------------------

model Order {
  id                       String           @id @default(cuid())
  orderNumber              String           @unique // e.g. "SIKA-2026-9281"
  customerId               String?
  guestEmail               String?
  guestPhone               String?
  guestName                String?

  fulfilmentType           FulfilmentType   @default(DELIVERY)
  fulfilmentStatus         FulfilmentStatus @default(PENDING_CONFIRMATION)
  paymentStatus            PaymentStatus    @default(PENDING)
  paymentMethod            PaymentMethod    @default(PAYSTACK)

  /** Authoritative financial amounts strictly in integer pesewas */
  subtotalPesewas          Int
  deliveryFeePesewas       Int              @default(0)
  discountPesewas          Int              @default(0)
  totalPesewas             Int

  customerNotes            String?
  rejectionReason          String?
  cancellationReason       String?
  deliveryAddressId        String?
  estimatedDeliveryMinutes Int              @default(45)

  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  customer        User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveryAddress DeliveryAddress?     @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  paymentAttempts PaymentAttempt[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([fulfilmentStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                      String   @id @default(cuid())
  orderId                 String
  menuItemId              String?
  /** Immutable snapshot of item name when order was placed */
  itemNameSnapshot        String
  /** Immutable unit price in integer pesewas when order was placed */
  unitPricePesewas        Int
  quantity                Int
  /** Total line cost in integer pesewas (unitPricePesewas + optionsDelta) * quantity */
  subtotalPesewas         Int
  /** JSON array of selected options snapshot */
  selectedOptionsSnapshot Json
  specialInstructions     String?
  createdAt               DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}

model OrderStatusHistory {
  id                String            @id @default(cuid())
  orderId           String
  fromStatus        FulfilmentStatus?
  toStatus          FulfilmentStatus
  note              String?
  changedByUserId   String?
  createdAt         DateTime          @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// PAYSTACK TRANSACTIONS & WEBHOOK IDEMPOTENCY
// ------------------------------------------------------------------------------

model PaymentAttempt {
  id               String               @id @default(cuid())
  orderId          String
  provider         PaymentMethod        @default(PAYSTACK)
  reference        String               @unique // Paystack transaction reference
  amountPesewas    Int
  currency         String               @default("GHS")
  status           PaymentAttemptStatus @default(INITIALIZED)
  channel          String?              // "mobile_money" (MTN, Telecel, AT) or "card"
  providerMetadata Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([reference])
  @@index([status])
}

model PaystackWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique // Paystack event ID or reference for idempotency
  eventType String   // e.g. "charge.success"
  payload   Json
  status    String   @default("PROCESSED") // "PROCESSED" | "FAILED" | "IGNORED"
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
}

// ------------------------------------------------------------------------------
// AUDIT LOGGING
// ------------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g. "UPDATE_MENU_PRICE", "CANCEL_ORDER", "REJECT_ORDER"
  entityType String   // e.g. "MenuItem", "Order", "User"
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
