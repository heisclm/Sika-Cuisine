generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  STAFF_CASHIER
  STAFF_KITCHEN
  DELIVERY_RIDER
  ADMIN
}

enum FulfilmentType {
  DELIVERY
  COLLECTION
}

enum FulfilmentStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  READY_FOR_PICKUP
  COLLECTED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  PAYSTACK
  CASH_ON_DELIVERY
  CASH_ON_COLLECTION
}

enum PaymentAttemptStatus {
  INITIALIZED
  SUCCESS
  FAILED
  ABANDONED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  passwordChangedAt DateTime?
  fullName          String
  phone             String
  role              Role      @default(CUSTOMER)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders              Order[]              @relation("CustomerOrders")
  deliveries          Order[]              @relation("RiderDeliveries")
  addresses           DeliveryAddress[]
  auditLogs           AuditLog[]
  statusChanges       OrderStatusHistory[]
  passwordResetTokens PasswordResetToken[]
  pushDevices         PushDeviceToken[]
  inAppNotifications  InAppNotification[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model MenuCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]

  @@index([slug])
  @@index([isActive])
}

model MenuItem {
  id                     String   @id @default(cuid())
  categoryId             String
  name                   String
  slug                   String   @unique
  description            String
  basePricePesewas       Int
  imageUrl               String
  isAvailable            Boolean  @default(true)
  isFeatured             Boolean  @default(false)
  spiceLevel             Int      @default(0)
  preparationTimeMinutes Int      @default(20)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  category     MenuCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroups MenuItemOptionGroup[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([isAvailable])
  @@index([isFeatured])
}

model MenuItemOptionGroup {
  id          String   @id @default(cuid())
  menuItemId  String
  name        String
  description String?
  minSelect   Int      @default(0)
  maxSelect   Int      @default(1)
  isRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  MenuItemOption[]

  @@index([menuItemId])
}

model MenuItemOption {
  id                String   @id @default(cuid())
  optionGroupId     String
  name              String
  priceDeltaPesewas Int      @default(0)
  isAvailable       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  group MenuItemOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId])
}

model DeliveryAddress {
  id             String   @id @default(cuid())
  customerId     String?
  recipientName  String
  recipientPhone String
  alternatePhone String?
  streetAddress  String
  areaLocality   String
  landmark       String?
  city           String   @default("Sunyani")
  deliveryNotes  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([customerId])
  @@index([areaLocality])
}

model Order {
  id                       String           @id @default(cuid())
  orderNumber              String           @unique
  customerId               String?
  guestEmail               String?
  guestPhone               String?
  guestName                String?

  fulfilmentType           FulfilmentType   @default(DELIVERY)
  fulfilmentStatus         FulfilmentStatus @default(PENDING)
  paymentStatus            PaymentStatus    @default(PENDING)
  paymentMethod            PaymentMethod    @default(PAYSTACK)

  subtotalPesewas          Int
  deliveryFeePesewas       Int              @default(0)
  discountPesewas          Int              @default(0)
  totalPesewas             Int

  customerNotes            String?
  rejectionReason          String?
  cancellationReason       String?
  deliveryAddressId        String?
  assignedRiderId          String?
  estimatedDeliveryMinutes Int              @default(45)
  idempotencyKey           String?          @unique

  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  customer        User?                @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  assignedRider   User?                @relation("RiderDeliveries", fields: [assignedRiderId], references: [id], onDelete: SetNull)
  deliveryAddress DeliveryAddress?     @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  paymentAttempts PaymentAttempt[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([customerId, createdAt])
  @@index([assignedRiderId])
  @@index([assignedRiderId, fulfilmentStatus])
  @@index([fulfilmentStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model OrderItem {
  id                      String   @id @default(cuid())
  orderId                 String
  menuItemId              String?
  itemNameSnapshot        String
  unitPricePesewas        Int
  quantity                Int
  subtotalPesewas         Int
  selectedOptionsSnapshot Json
  specialInstructions     String?
  createdAt               DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}

model OrderStatusHistory {
  id              String            @id @default(cuid())
  orderId         String
  fromStatus      FulfilmentStatus?
  toStatus        FulfilmentStatus
  note            String?
  changedByUserId String?
  createdAt       DateTime          @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  orderId          String
  provider         PaymentMethod        @default(PAYSTACK)
  reference        String               @unique
  amountPesewas    Int
  currency         String               @default("GHS")
  status           PaymentAttemptStatus @default(INITIALIZED)
  channel          String?
  providerMetadata Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([reference])
  @@index([status])
}

model PaystackWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String
  payload   Json
  status    String   @default("PROCESSED")
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model DeliveryZone {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String
  feePesewas       Int
  estimatedMinutes Int      @default(35)
  localities       String[]
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model RestaurantSettings {
  id                  String   @id @default("default")
  name                String   @default("Sika Cuisine")
  tagline             String   @default("Sunyani, Ghana")
  phone               String   @default("0533376760")
  whatsapp            String   @default("+233533376760")
  address             String   @default("Commercial Street, Sunyani Central, Bono Region, Ghana")
  isAcceptingOrders   Boolean  @default(true)
  kitchenScheduleMode String   @default("AUTO")
  isDeliveryEnabled   Boolean  @default(true)
  isCollectionEnabled Boolean  @default(true)
  weekdayHours        String   @default("10:00 AM - 10:00 PM")
  sundayHours         String   @default("12:00 PM - 9:00 PM")
  updatedAt           DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushDeviceToken {
  id            String   @id @default(cuid())
  userId        String?
  expoPushToken String   @unique
  platform      String   @default("unknown")
  isActive      Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
}

model NotificationLog {
  id           String   @id @default(cuid())
  channel      String
  provider     String
  recipient    String
  eventType    String
  orderId      String?
  status       String
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
}

model InAppNotification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String
  orderNumber String?
  actionUrl   String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([orderNumber])
}
