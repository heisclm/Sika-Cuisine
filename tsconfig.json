{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@sika/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": [
    "prisma/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps"
  ]
}
